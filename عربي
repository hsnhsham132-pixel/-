      <div className="mb-8 flex items-center justify-between bg-slate-50 p-4 rounded-[2rem] border border-slate-200">
        <div className="flex items-center gap-3">
          <div className="bg-blue-900 p-2 rounded-full text-white shadow-lg">
            <User size={18} />
          </div>
          {isEditingName ? (
            <div className="flex items-center gap-2">
              <input 
                value={tempName}
                onChange={(e) => setTempName(e.target.value)}
                autoFocus
                className="bg-white border border-blue-200 rounded-lg px-2 py-1 text-sm text-right outline-none w-32"
              />
