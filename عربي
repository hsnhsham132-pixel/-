      question: "ما الموقع الإعرابي لـ 'امرؤٌ' في: 'لولا الاجتهادُ لمَا ارتقى بوطنه امرؤٌ'؟",
      options: ["مبتدأ مرفوع", "مضاف إليه", "فاعل مرفوع", "مفعول به"],
      correct: 2
    },
    {
      id: 2,
      question: "من سمات مدرسة الديوان التي تميزها عن الإحياء والبعث:",
      options: ["الاهتمام بالناحية البيانية", "طغيان الجانب الفكري", "الحنين لمواطن الذكريات", "استخدام الرمز"],
      correct: 1
    },
    {
      id: 3,
      question: "في قصة الأيام، كان الصبي يشعر بالوحدة في غرفته بالقاهرة لأن:",
      options: ["أخاه كان يتركه ليذهب لأصحابه", "الغرفة كانت موحشة ومظلمة", "لم يكن يحب دروس الأزهر", "كان يفتقد والدته بشدة"],
      correct: 0
    }
  ];

  // --- Handlers ---
  const handleAnswer = (index) => {
    const currentQ = examQuestions[currentQuestion];
    if (index !== currentQ.correct) {
      setWrongAnswers(prev => [...prev, {
        question: currentQ.question,
        yourAnswer: currentQ.options[index],
        correctAnswer: currentQ.options[currentQ.correct]
      }]);
    }
    
    const newAnswers = [...userAnswers, index];
    setUserAnswers(newAnswers);
    if (currentQuestion + 1 < examQuestions.length) {
      setCurrentQuestion(currentQuestion + 1);
    } else {
      let score = 0;
      newAnswers.forEach((ans, i) => {
        if (ans === examQuestions[i].correct) score++;
      });
      setQuizScore(score);
    }
  };

  const saveName = () => {
    if (tempName.trim()) {
      setUserName(tempName);
      setIsEditingName(false);
    }
  };

