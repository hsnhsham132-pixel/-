             <div className="absolute inset-0 animate-ping bg-orange-400/20 rounded-full"></div>
          </div>
          <h2 className="text-4xl font-black mb-2 text-slate-900 tracking-tighter">أحسنت يا {userName}!</h2>
          <p className="text-slate-400 font-bold mb-10">لقد أنجزت المهمة بنجاح</p>
          <div className="bg-white p-10 rounded-[4rem] shadow-2xl mb-12 border-b-8 border-blue-900">
             <div className="text-8xl font-black text-blue-900 tracking-tighter leading-none">{quizScore}</div>
             <div className="text-slate-300 font-black mt-2 text-xl italic underline decoration-blue-900/10">Score Out of {examQuestions.length}</div>
